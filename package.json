{
  "name": "discord-ai-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "A sdk made to allow ai to interact with discord api for discord bots",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rubr1c/discord-ai-sdk.git"
  },
  "homepage": "https://github.com/Rubr1c/discord-ai-sdk#readme",
  "bugs": {
    "url": "https://github.com/Rubr1c/discord-ai-sdk/issues"
  },
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.17 || >=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest -c vitest.config.ts",
    "test:run": "vitest run -c vitest.config.ts",
    "docs": "typedoc",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm build"
  },
  "keywords": [
    "discord",
    "discord.js",
    "ai",
    "vercel-ai-sdk",
    "ai-sdk",
    "llm",
    "sdk",
    "middleware",
    "bot",
    "tools",
    "slash-commands",
    "typescript"
  ],
  "packageManager": "pnpm@10.13.1",
  "peerDependencies": {
    "ai": "^5.0.0",
    "discord.js": "^14.0.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "@vitest/coverage-v8": "^4.1.6",
    "ai": "^6.0.177",
    "discord.js": "^14.26.4",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.19",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
